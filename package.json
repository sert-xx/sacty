{
  "name": "sacty",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/daemon",
    "apps/web",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build -w @sacty/core -w @sacty/daemon -w @sacty/web -w @sacty/cli",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b packages/core apps/daemon packages/cli && npm run typecheck -w @sacty/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
