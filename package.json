{
  "name": "sacty",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/daemon",
    "apps/web",
    "packages/cli"
  ],
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "build": "npm run build -w @sacty/core -w @sacty/daemon -w @sacty/web -w @sacty/cli",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs:diagrams": "node scripts/docs-diagrams/build.mjs",
    "docs:screenshots": "node scripts/docs-screenshots/capture.mjs",
    "typecheck": "tsc -b packages/core apps/daemon packages/cli && npm run typecheck -w @sacty/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "jsdom": "^26.1.0",
    "playwright": "1.61.1",
    "typescript": "^5.9.2",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
}
