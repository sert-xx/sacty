{
  "name": "@sacty/daemon",
  "version": "1.13.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./context-template": {
      "types": "./dist/context-template.d.ts",
      "default": "./dist/context-template.js"
    },
    "./exit-codes": {
      "types": "./dist/exit-codes.d.ts",
      "default": "./dist/exit-codes.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./secrets": {
      "types": "./dist/secrets.d.ts",
      "default": "./dist/secrets.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@sacty/core": "1.13.0",
    "hono": "^4.9.6",
    "smol-toml": "^1.9.1",
    "undici": "^7.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
